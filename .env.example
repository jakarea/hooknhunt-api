APP_NAME="Hook & Hunt ERP"
APP_ENV=local
APP_KEY=base64:+m62I7+myxGZ37fEo5Ejom333rbBuEBvXGFSuzkGDtA=
APP_DEBUG=true
APP_URL=https://hooknhunt-api.test/

APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Auth Configuration
AUTH_GUARD=api

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hooknhunt
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.hooknhunt.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# EPS PAYMENT GATEWAY CONFIGURATION
# ============================================
# EPS (e-Payment Service) - Bangladesh Payment Gateway
# Supports: Internet Banking, Mobile Banking, Card Payments
# Reference: https://github.com/EPS-PG/EPS_Laravel
#
# Official SDK Environment Variables (use these exactly)

# Mode: sandbox or live
EPS_MODE=sandbox

# Base URL (change based on mode)
# Sandbox: https://sandboxpgapi.eps.com.bd
# Live: https://pgapi.eps.com
EPSBaseURL=https://sandboxpgapi.eps.com.bd

# API Credentials
EPSHashkey=
EPSUserName=
EPSPassword=
EPSStoreID=
EPSMerchentID=
EPSDeviceTypeID=0

# Callback URLs (these should point to your API)
EPS_SUCCESS_URL=https://www.hooknhunt.com/api/v2/store/payments/eps/success
EPS_FAIL_URL=https://www.hooknhunt.com/api/v2/store/payments/eps/fail
EPS_CANCEL_URL=https://www.hooknhunt.com/api/v2/store/payments/eps/cancel
EPS_IPN_URL=https://www.hooknhunt.com/api/v2/store/payments/eps/ipn

# Request timeout (seconds)
EPS_TIMEOUT=30

# Verification Settings (for pending payment cron job)
EPS_VERIFICATION_ENABLED=true
EPS_VERIFY_CRON_SECRET=
EPS_VERIFY_CRON_MINUTES=15

# ============================================
# LAZYCHAT INTEGRATION
# ============================================
# Lazychat retail platform webhook configuration
LAZYCHAT_ENABLED=true

# Incoming API authentication (Bearer token for LazyChat to access our API)
# Generate a secure token and share it with LazyChat team
LAZYCHAT_API_TOKEN=your-lazychat-api-token-here

# Outgoing webhook configuration (we send webhooks to LazyChat)
LAZYCHAT_WEBHOOK_CREATE_URL=https://flow.lazychat.io/api/exec/flows/69e9bc9f7fd64cf4ca2f9a71/WRkTno7aJAHU
LAZYCHAT_WEBHOOK_CREATE_TOKEN=c2bcecd19a7d0afca4cd4b46aca8ecc194df4de693c0bd1699edd1ccfcbea62b
LAZYCHAT_WEBHOOK_DELETE_URL=https://flow.lazychat.io/api/exec/flows/69e9bc9f7fd64cf4ca2f9a71/Hj2A7QqT1K0N
LAZYCHAT_WEBHOOK_DELETE_TOKEN=bfd4dcab6657d9a6d296efe3599e624bec424fc1dbd2df471710e717ef828e6f
LAZYCHAT_QUEUE_CONNECTION=database
LAZYCHAT_QUEUE_NAME=lazychat-webhooks
LAZYCHAT_MAX_RETRIES=3
LAZYCHAT_RETRY_DELAY=30
LAZYCHAT_TIMEOUT=10
LAZYCHAT_NOTIFY_ON_FAILURE=true
LAZYCHAT_ADMIN_EMAIL=admin@hooknhunt.com
LAZYCHAT_LOG_RETENTION_DAYS=30

# ============================================
# ROLE CONFIGURATION
# ============================================
# Customer Role IDs
RETAIL_CUSTOMER_ROLE_ID=10
RETAIL_CUSTOMER_ROLE_SLUG=retail_customer
WHOLESALE_CUSTOMER_ROLE_ID=11
WHOLESALE_CUSTOMER_ROLE_SLUG=wholesale_customer

# Staff Role IDs
SUPER_ADMIN_ROLE_ID=1
SUPER_ADMIN_ROLE_SLUG=super_admin
ADMIN_ROLE_ID=2
ADMIN_ROLE_SLUG=admin
MANAGER_ROLE_ID=3
MANAGER_ROLE_SLUG=manager
SUPERVISOR_ROLE_ID=4
SUPERVISOR_ROLE_SLUG=supervisor
SENIOR_STAFF_ROLE_ID=5
SENIOR_STAFF_ROLE_SLUG=senior_staff
SELLER_ROLE_ID=6
SELLER_ROLE_SLUG=seller
STORE_KEEPER_ROLE_ID=7
STORE_KEEPER_ROLE_SLUG=store_keeper
MARKETER_ROLE_ID=8
MARKETER_ROLE_SLUG=marketer

# Supplier Role IDs
SUPPLIER_ROLE_ID=9
SUPPLIER_ROLE_SLUG=supplier

# ============================================
# ORDER CONFIGURATION
# ============================================
# Order Limits
MAX_ITEMS_PER_ORDER=100
MAX_QUANTITY_PER_ITEM=1000
MIN_ORDER_AMOUNT=0
MAX_ORDER_AMOUNT=99999999.99

# ============================================
# PAYMENT CONFIGURATION
# ============================================
# Default Gateway
DEFAULT_PAYMENT_GATEWAY=sslcommerz

# SSLCommerz Configuration
SSLCOMMERZ_ENABLED=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# EPS Configuration
EPS_ENABLED=true
EPS_MERCHANT_ID=
EPS_SECRET_KEY=
EPS_SANDBOX=true

# bKash Configuration
BKASH_ENABLED=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Nagad Configuration
NAGAD_ENABLED=false
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX=true

# EMI Configuration
EMI_ENABLED=true
EMI_MIN_AMOUNT=5000

# COD Configuration
COD_ENABLED=true
COD_MAX_AMOUNT=50000
COD_ADDITIONAL_CHARGE=0

# Payment Verification
AUTO_VERIFY_PAYMENTS=false
PAYMENT_VERIFY_CRON_INTERVAL=5
PENDING_PAYMENT_EXPIRY_MINUTES=30

# Payment Currency
PAYMENT_CURRENCY=BDT
PAYMENT_CURRENCY_SYMBOL=৳
PAYMENT_CURRENCY_POSITION=prefix

# Security
VERIFY_IPN_SIGNATURE=true
IPN_SECRET_KEY=
PAYMENT_IP_WHITELIST=
